# Copie para .env. Valores de desenvolvimento; nunca versione o .env.

# Portas no host (mude se houver conflito)
POSTGRES_PORT=5432
REDIS_PORT=6379
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
PHOENIX_PORT=6006
PHOENIX_OTLP_PORT=4317

# Postgres (senha só de desenvolvimento)
POSTGRES_USER=forja
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_DB=forja
DATABASE_URL=postgresql://forja:dev-only-change-me@localhost:5432/forja

REDIS_URL=redis://localhost:6379/0
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Observabilidade (OTLP gRPC para o Phoenix do perfil "observability")
# Backend OTLP/HTTP do trace (Phoenix: http://localhost:6006/v1/traces)
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_SERVICE_NAME=forja

# Domínio: máximo de voltas Test -> Build antes de recusar (padrão 3; ver ADR 0031)
FORJA_MAX_CICLOS_BUILD_TEST=3

# GitHub App (ver docs/github-app.md). Segredos só no seu .env local.
FORJA_GITHUB_APP_ID=
FORJA_GITHUB_APP_PRIVATE_KEY_FILE=
FORJA_GITHUB_WEBHOOK_SECRET=

# Binário (`uv run forja serve` e `uv run forja worker`)
# Repositórios que podem acionar agentes, separados por vírgula. Vazio recusa tudo.
FORJA_REPOS_HABILITADOS=
# Clones locais preparados pelo operador: <FORJA_REPOS_DIR>/<dono>/<nome>
FORJA_REPOS_DIR=data/repos
FORJA_WORKTREES_DIR=data/worktrees
# Dry-run por padrão: só "true" escreve no GitHub.
FORJA_PUBLICAR=false
# SHA-256 (hex) do token do botão de pânico (ADR 0019)
FORJA_PANICO_TOKEN_SHA256=
FORJA_API_HOST=127.0.0.1
FORJA_API_PORTA=8000
FORJA_METRICAS_PORTA=9102

# Anthropic (chave real só no seu .env local)
ANTHROPIC_API_KEY=

# Knowledge (M2): único embedder suportado é "falso" (determinístico, sem modelo); não há default
FORJA_EMBEDDER=
FORJA_EMBEDDER_DIMENSAO=64
# Emitidos pelo workflow por sessão; nunca versione valores reais
FORJA_KNOWLEDGE_TOKEN=
FORJA_KNOWLEDGE_TOKEN_SECRET=
